pkgname=argvus-splash
pkgver=0.1.1
pkgrel=1
pkgdesc="Argvus boot splash theme for Plymouth"
arch=('any')
url="https://github.com/argvus/argvus-splash"
license=('GPL-3.0-or-later')

depends=('plymouth')

optdepends=(
    'mkinitcpio: rebuild initramfs (Arch Linux)'
    'dracut: rebuild initramfs (alternative)'
)

conflicts=('argvus-plymouth')
replaces=('argvus-plymouth')

install=argvus-splash.install

source=(
    "argvus.plymouth"
    "argvus.script"
    "argvus-logo.png"
    "argvus-text.png"
    "progress-bar.png"
    "progress-bar-track.png"
    "bullet.png"
    "entry-box.png"
)

sha256sums=(
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
)

package() {
    local dest="${pkgdir}/usr/share/plymouth/themes/argvus"

    install -Dm644 argvus.plymouth \
        "${dest}/argvus.plymouth"

    install -Dm644 argvus.script \
        "${dest}/argvus.script"

    install -Dm644 argvus-logo.png \
        "${dest}/argvus-logo.png"

    install -Dm644 argvus-text.png \
        "${dest}/argvus-text.png"

    install -Dm644 progress-bar.png \
        "${dest}/progress-bar.png"

    install -Dm644 progress-bar-track.png \
        "${dest}/progress-bar-track.png"

    install -Dm644 bullet.png \
        "${dest}/bullet.png"

    install -Dm644 entry-box.png \
        "${dest}/entry-box.png"
}
