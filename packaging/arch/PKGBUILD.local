# Maintainer: William C. Canin
pkgname=argvus-splash
pkgver=0.2.0
pkgrel=1
pkgdesc="Argvus boot splash theme for Plymouth"
arch=('any')
url="https://github.com/argvus/argvus-splash"
license=('GPL-3.0-or-later')
options=('!debug')
depends=('plymouth')
optdepends=(
  'mkinitcpio: rebuild initramfs (Arch Linux)'
  'dracut: rebuild initramfs (alternative)'
)
conflicts=('argvus-plymouth')
replaces=('argvus-plymouth')
install="${pkgname}.install"

source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=('SKIP')

package() {
  cd "${pkgname}-${pkgver}"

  install -Dm644 src/argvus.plymouth \
    "${pkgdir}/usr/share/plymouth/themes/argvus/argvus.plymouth"
  install -Dm644 src/argvus.script \
    "${pkgdir}/usr/share/plymouth/themes/argvus/argvus.script"
  install -Dm644 src/argvus-logo.png \
    "${pkgdir}/usr/share/plymouth/themes/argvus/argvus-logo.png"
  install -Dm644 src/argvus-text.png \
    "${pkgdir}/usr/share/plymouth/themes/argvus/argvus-text.png"
  install -Dm644 src/progress-bar.png \
    "${pkgdir}/usr/share/plymouth/themes/argvus/progress-bar.png"
  install -Dm644 src/progress-bar-track.png \
    "${pkgdir}/usr/share/plymouth/themes/argvus/progress-bar-track.png"
  install -Dm644 src/bullet.png \
    "${pkgdir}/usr/share/plymouth/themes/argvus/bullet.png"
  install -Dm644 src/entry-box.png \
    "${pkgdir}/usr/share/plymouth/themes/argvus/entry-box.png"
  install -Dm644 src/entry-line.png \
    "${pkgdir}/usr/share/plymouth/themes/argvus/entry-line.png"
  install -Dm644 src/argvus-uki-splash.bmp \
    "${pkgdir}/usr/share/plymouth/themes/argvus/argvus-uki-splash.bmp"
}
