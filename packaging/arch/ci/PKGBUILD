# Maintainer: William C. Canin
pkgname=argvus-boot-splash
pkgver=0.1.0
pkgrel=1
pkgdesc="ARGVUS boot splash theme for Plymouth"
arch=('any')
url="https://github.com/argvus/argvus-boot-splash"
license=('GPL-3.0-only')
depends=('plymouth')
optdepends=(
  'mkinitcpio: rebuild initramfs (Arch Linux)'
  'dracut: rebuild initramfs (alternative)'
)
options=('!debug')
conflicts=('argvus-plymouth')
replaces=('argvus-plymouth')
install="${pkgname}.install"

source=(
  "${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz"
)
sha256sums=()

# shellcheck disable=SC1091
_functions_file="${startdir:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)}/../common/functions.sh"
. "$_functions_file"

prepare() {
  arch_normalize_source_tree
}

check() {
  arch_check_splash_payload
}

package() {
  arch_package_splash_payload
}
